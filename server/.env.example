# --- runtime ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- storage ---
DB_PATH=./data/xsg.db

# --- limits ---
MAX_MESSAGES_PER_SEC=20
MAX_PLAYERS_PER_MAP=50
WORLD_TICK_MS=200

# --- auth ---
TOKEN_TTL_SEC=86400

# --- 云更新分流 (可选, R2/CDN) ---
# 配置后 /update/manifest 把更新包下载改写成 <UPDATE_CDN_BASE>/<file> 绝对 URL,
# 客户端(XdRs_Online_Update 已支持)直接从 R2/CDN 下载, 不占服务器带宽。
# 留空 = 回退本地 /update/download 流式下发。
# 例: UPDATE_CDN_BASE=https://pub-5a78ce3b8e9f4832948f79b705878aa5.r2.dev  (或绑自定义域名 https://updates.yourdomain.com)
UPDATE_CDN_BASE=

# --- 发布脚本 publish-release.mjs 用 (仅打包/发版机器需要, 服务器运行时不读) ---
# XSG_SKIP_LOCAL_ZIP=1: 发布时不把大 zip / 增量包拷到服务器 releases/, 只保留 manifest.json,
#   服务器磁盘占用最小化。仅当 zip 会上 R2 (配了 UPDATE_CDN_BASE 或 XSG_R2_REMOTE) 才生效,
#   否则自动忽略并保留本地副本 (防客户端回退下载 404)。
# XSG_R2_REMOTE: rclone 远端名 (如 r2:xsg-updates), 设了就发布时自动 rclone 上传到 R2;
#   不设则脚本只列出需手动上传(控制台拖)的文件。rclone 凭证只存打包机本地, 服务器永不接触。
# XSG_SKIP_LOCAL_ZIP=1
# XSG_R2_REMOTE=r2:xsg-updates

# --- logs ---
LOG_LEVEL=info
