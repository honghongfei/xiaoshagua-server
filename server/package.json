{
  "name": "xiaoshagua-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative game server for 《我的小傻瓜》online mode (XSG-Online).",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "gm": "tsx scripts/gm.ts",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "nanoid": "^5.0.7",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "socket.io": "^4.8.0",
    "socket.io-msgpack-parser": "^3.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
